# MatchMaker Backend – Environment Variables
# For local: copy .env.local.example to .env.local
# For production: copy .env.production.example to .env.production
# Or copy this file to .env for default

# ─── Server ─────────────────────────────────────────────────
PORT=3000

# ─── Database (DB_* vars; config builds DATABASE_URL) ────────
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=matchmaker
DB_USER=matchmaker
DB_PASSWORD=

# SSL (for Aiven / cloud MySQL with self-signed certs)
# When DATABASE_URL is set, sslaccept=accept_invalid_certs is auto-injected at runtime.
# Set DB_SSL_STRICT=true to skip (use strict cert verification).
SSL_REQUIRE=true
DB_SSL_ACCEPT=accept_invalid_certs

# ─── Redis (optional; REDIS_* vars) ─────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=false

# ─── App ────────────────────────────────────────────────────
ENVIRONMENT=DEVELOPMENT
APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ─── Feature flags ──────────────────────────────────────────
JOBS_ENABLED=true

# ─── Rating system ──────────────────────────────────────────
RATING_ALGORITHM=elo
RATING_K_FACTOR=32
RATING_ENABLE_HISTORY=true

# ─── WhatsApp (scheduling automation) ───────────────────────
# Provider: mock | whapi | wasender
WHATSAPP_PROVIDER=mock

# Minimum interval between outgoing WhatsApp messages (ms)
# Used by backend whatsappService to rate-limit sends even if provider-side protection is disabled.
WHATSAPP_MIN_SEND_INTERVAL_MS=3000

# Bot phone (added to match groups) — used by whapi/wasender
# WHATSAPP_BOT_NUMBER=

# Whapi (https://whapi.cloud/docs) — when WHATSAPP_PROVIDER=whapi
# WHAPI_URL=https://gate.whapi.cloud
# WHAPI_TOKEN=
# Webhook HMAC secret — set in the Whapi dashboard under Webhook settings
# WHAPI_WEBHOOK_SECRET=

# Wasender (https://wasenderapi.com/api-docs) — when WHATSAPP_PROVIDER=wasender
# WASENDER_API_URL=https://www.wasenderapi.com
# WASENDER_API_KEY=
# Webhook HMAC secret — set in the Wasender dashboard under Webhook settings
# WASENDER_WEBHOOK_SECRET=

# Dev user (for login; seed uses these to create/update dev users)
DEV_USER_EMAIL=alex@example.com
DEV_USER_PASSWORD=dev123

# Minimum interval between outgoing WhatsApp messages (ms)
# Used by backend whatsappService to rate-limit sends even if provider-side protection is disabled.
ENCRYPTION_KEY=XXXXXXXXXXXXXXX
BOOKING_SUBMIT_ENABLED=false