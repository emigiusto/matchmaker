# Example environment file for MatchMaker backend

# MySQL connection (use either DATABASE_URL or DB_* vars)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/matchmaker"
# Or use separate vars (e.g. for Render, Docker):
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=matchmaker
# DB_USER=matchmaker
# DB_PASSWORD=your_password
# Redis (use either REDIS_URL or REDIS_* vars)
# REDIS_URL="redis://localhost:6379"
# Or use separate vars (e.g. for Render):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=false

# Rating system configuration
RATING_ALGORITHM=elo
RATING_K_FACTOR=32
RATING_ENABLE_HISTORY=true

# Server port
PORT=3000

# App base URL (for invite links)
APP_BASE_URL=https://v0-tennis-matchmaker-mvp.vercel.app

# Feature flags
JOBS_ENABLED=true

# WhatsApp (scheduling automation)
WHATSAPP_PROVIDER=mock
# WHATSAPP_PROVIDER=whapi
# WHAPI_URL (default: https://gate.whapi.cloud)
# WHAPI_TOKEN
# WHATSAPP_BOT_NUMBER=34604131625 (E.164, no + or spaces)

# Other secrets (add as needed)
# JWT_SECRET=your_jwt_secret
