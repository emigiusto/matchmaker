# MatchMaker Backend – Environment Variables
# Copy to .env and fill in values

# ─── Server ─────────────────────────────────────────────────
PORT=3000

# ─── Database (DB_* vars; config builds DATABASE_URL) ────────
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=matchmaker
DB_USER=matchmaker
DB_PASSWORD=

# SSL (for Aiven / cloud MySQL with self-signed certs)
# When DATABASE_URL is set, sslaccept=accept_invalid_certs is auto-injected at runtime.
# Set DB_SSL_STRICT=true to skip (use strict cert verification).
SSL_REQUIRE=true
DB_SSL_ACCEPT=accept_invalid_certs

# ─── Redis (optional; REDIS_* vars) ─────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=false

# ─── App ────────────────────────────────────────────────────
ENVIRONMENT=DEVELOPMENT
APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ─── Feature flags ──────────────────────────────────────────
JOBS_ENABLED=true

# ─── Rating system ──────────────────────────────────────────
RATING_ALGORITHM=elo
RATING_K_FACTOR=32
RATING_ENABLE_HISTORY=true

# ─── WhatsApp (scheduling automation) ───────────────────────
WHATSAPP_PROVIDER=mock
# WHATSAPP_PROVIDER=whapi
# WHAPI_URL=https://gate.whapi.cloud
# WHAPI_TOKEN=
# WHATSAPP_BOT_NUMBER=
