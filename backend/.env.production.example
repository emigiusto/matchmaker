# MatchMaker Backend – PRODUCTION (Aiven, Render, etc.)
# Copy to .env.production and fill in values

# ─── Server ─────────────────────────────────────────────────
PORT=3000

# ─── Database (Aiven / cloud MySQL) ──────────────────────────
DB_DIALECT=mysql
DB_HOST=your-db-host.aivencloud.com
DB_PORT=19619
DB_NAME=matchmaker
DB_USERNAME=avnadmin
DB_PASSWORD=

# SSL (required for cloud MySQL)
SSL_REQUIRE=true
DB_SSL_ACCEPT=accept_invalid_certs

# ─── Redis (Render / cloud) ──────────────────────────────────
REDIS_HOST=your-redis-host.render.com
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=true

# ─── App ────────────────────────────────────────────────────
ENVIRONMENT=PRODUCTION
JWT_SECRET=  # Required for auth: use a long random string in production
# SEED_ALLOW_PRODUCTION=true   # Uncomment to allow npm run seed:prod (use with caution)
APP_BASE_URL=https://your-app.onrender.com
CORS_ORIGIN=https://your-frontend.vercel.app
# Frontend base URL for match/signup links in WhatsApp messages (e.g. https://matchmaker-flame.vercel.app)
FRONTEND_BASE_URL=https://matchmaker-flame.vercel.app

# ─── Feature flags ───────────────────────────────────────────
JOBS_ENABLED=true

# ─── Rating system ───────────────────────────────────────────
RATING_ALGORITHM=elo
RATING_K_FACTOR=32
RATING_ENABLE_HISTORY=true

# ─── WhatsApp (whapi | wasender) ─────────────────────────────
WHATSAPP_PROVIDER=whapi

# Minimum interval between outgoing WhatsApp messages (ms) enforced by backend whatsappService
WHATSAPP_MIN_SEND_INTERVAL_MS=3000

# Bot phone (added to match groups)
WHATSAPP_BOT_NUMBER=

# Whapi (https://whapi.cloud/docs) — when WHATSAPP_PROVIDER=whapi
WHAPI_URL=https://gate.whapi.cloud
WHAPI_TOKEN=

# Wasender (https://wasenderapi.com/api-docs) — when WHATSAPP_PROVIDER=wasender
# WHATSAPP_PROVIDER=wasender
# WASENDER_API_URL=https://www.wasenderapi.com
# WASENDER_API_KEY=

ENCRYPTION_KEY=XXXXXXXXXXXXXXX
BOOKING_SUBMIT_ENABLED=false

ACEUP_API_URL=https://tenis-app-backend.com
ACEUP_API_SECRET=xxxxx