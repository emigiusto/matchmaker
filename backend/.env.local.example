# MatchMaker Backend – LOCAL development
# Copy to .env.local and fill in values

# ─── Server ─────────────────────────────────────────────────
PORT=3000

# ─── Database (local MySQL) ──────────────────────────────────
# Prisma requires DATABASE_URL. Set it directly, or use DB_* (server builds it at startup)
DATABASE_URL=mysql://matchmaker:@localhost:3306/matchmaker?sslaccept=accept_invalid_certs
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=matchmaker
# DB_USER=matchmaker
# DB_PASSWORD=

# SSL (not needed for local)
# DB_SSL_ACCEPT=accept_invalid_certs

# ─── Redis (optional) ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=false

# ─── App ────────────────────────────────────────────────────
ENVIRONMENT=DEVELOPMENT
JWT_SECRET=dev-secret-change-in-production  # For auth (signup/login)

# Dev user (for login; seed/ensure-dev-user-data use these)
DEV_USER_EMAIL=alex@example.com
DEV_USER_PASSWORD=dev123
APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# ─── Feature flags ───────────────────────────────────────────
JOBS_ENABLED=true

# ─── Rating system ───────────────────────────────────────────
RATING_ALGORITHM=elo
RATING_K_FACTOR=32
RATING_ENABLE_HISTORY=true

# ─── WhatsApp (mock for local; whapi/wasender for real) ──────
WHATSAPP_PROVIDER=mock

# Minimum interval between outgoing WhatsApp messages (ms)
WHATSAPP_MIN_SEND_INTERVAL_MS=3000

# Bot phone (added to match groups)
# WHATSAPP_BOT_NUMBER=

# Whapi — when WHATSAPP_PROVIDER=whapi
# WHAPI_URL=https://gate.whapi.cloud
# WHAPI_TOKEN=

# Wasender — when WHATSAPP_PROVIDER=wasender
# WASENDER_API_URL=https://www.wasenderapi.com
# WASENDER_API_KEY=

ENCRYPTION_KEY=XXXXXXXXXXXXXXX
BOOKING_SUBMIT_ENABLED=false