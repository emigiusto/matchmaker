# MatchMaker Backend – LOCAL development
# Copy to .env.local and fill in values

# ─── Server ─────────────────────────────────────────────────
PORT=3000

# ─── Database (local MySQL) ──────────────────────────────────
# Prisma requires DATABASE_URL. Set it directly, or use DB_* (server builds it at startup)
DATABASE_URL=mysql://matchmaker:@localhost:3306/matchmaker?sslaccept=accept_invalid_certs
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=matchmaker
# DB_USER=matchmaker
# DB_PASSWORD=

# SSL (not needed for local)
# DB_SSL_ACCEPT=accept_invalid_certs

# ─── Redis (optional) ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=false

# ─── App ────────────────────────────────────────────────────
ENVIRONMENT=DEVELOPMENT
APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# ─── Feature flags ───────────────────────────────────────────
JOBS_ENABLED=true

# ─── Rating system ───────────────────────────────────────────
RATING_ALGORITHM=elo
RATING_K_FACTOR=32
RATING_ENABLE_HISTORY=true

# ─── WhatsApp (use mock for local) ───────────────────────────
WHATSAPP_PROVIDER=mock
# WHAPI_URL=https://gate.whapi.cloud
# WHAPI_TOKEN=
# WHATSAPP_BOT_NUMBER=
