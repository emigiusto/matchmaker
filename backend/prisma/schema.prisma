generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

////////////////////////////////////////////////////////////
// USER — identity, auth, contact info (guest-first)
////////////////////////////////////////////////////////////

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  isGuest      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  player         Player?
  availabilities Availability[]
  invitesSent    Invite[]       @relation("InvitesSent")
  notifications  Notification[]

  // Social graph
  friendships Friendship[] @relation("UserFriendships")
  friendOf    Friendship[] @relation("FriendUser")

  guestContacts GuestContact[]

  // Groups
  groupMemberships GroupMember[]
  groupsOwned      Group[]       @relation("GroupsOwned")

  // Chat
  sentMessages Message[] @relation("SenderMessages")

  // Match participation
  matchParticipants MatchParticipant[]

  reminders Reminder[]

  resultsWon        Result[]        @relation("WinnerUser")

  schedulingRequestsAsHost     SchedulingRequest[] @relation("SchedulingHost")
  schedulingRequestsAsHostPartner SchedulingRequest[] @relation("SchedulingHostPartner")
  schedulingCandidatesAsContact SchedulingCandidate[] @relation("SchedulingContact")

  @@index([createdAt])
}

////////////////////////////////////////////////////////////
// PLAYER — tennis-specific persona
////////////////////////////////////////////////////////////

model Player {
  id              String   @id @default(uuid())
  userId          String   @unique
  displayName     String?
  levelValue      Float?
  levelConfidence Float?
  defaultCity     String?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?
  lastMatchAt     DateTime?

  user              User            @relation(fields: [userId], references: [id])
  preferredSurfaces PlayerSurface[]
  matchesA          Match[]         @relation("PlayerA")
  matchesB          Match[]         @relation("PlayerB")
  ratingHistory     RatingHistory[]   // <--- Add this line

  @@index([userId])
  @@index([levelValue])
  @@index([defaultCity])
}

////////////////////////////////////////////////////////////
// PLAYER SURFACES
////////////////////////////////////////////////////////////

model PlayerSurface {
  id       String @id @default(uuid())
  playerId String
  surface  String

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, surface])
  @@index([playerId])
}

////////////////////////////////////////////////////////////
// GUEST CONTACT
////////////////////////////////////////////////////////////

model GuestContact {
  id          String   @id @default(uuid())
  ownerUserId String
  name        String
  phone       String
  createdAt   DateTime @default(now())

  owner       User         @relation(fields: [ownerUserId], references: [id])
  friendships Friendship[]

  @@index([ownerUserId])
  @@index([phone])
}

////////////////////////////////////////////////////////////
// FRIENDSHIP — explicit social graph
// Exactly one of friendUserId or guestContactId must be set
////////////////////////////////////////////////////////////

model Friendship {
  id             String   @id @default(uuid())
  userId         String
  friendUserId   String?
  guestContactId String?
  createdAt      DateTime @default(now())

  user         User          @relation("UserFriendships", fields: [userId], references: [id])
  friendUser   User?         @relation("FriendUser", fields: [friendUserId], references: [id])
  guestContact GuestContact? @relation(fields: [guestContactId], references: [id])

  @@unique([userId, friendUserId, guestContactId])
  @@index([userId])
  @@index([friendUserId])
  @@index([guestContactId])
}

////////////////////////////////////////////////////////////
// AVAILABILITY
////////////////////////////////////////////////////////////

model Availability {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime
  startTime       DateTime
  endTime         DateTime
  locationText    String
  minLevel        Float?
  maxLevel        Float?
  preferredSurface String?
  status          AvailabilityStatus @default(open)
  createdAt       DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  invites Invite[]
  matches Match[]

  @@index([userId])
  @@index([date])
  @@index([status])
}

enum AvailabilityStatus {
  open        // Open to find matches
  invited     // Has an invite sent
  matched     // Match already confirmed
  closed      // Canceled or closed by user
}

////////////////////////////////////////////////////////////
// INVITE
////////////////////////////////////////////////////////////
model Invite {
  id             String           @id @default(uuid())
  token          String           @unique
  inviterUserId  String
  availabilityId String
  status         InviteStatus     @default(pending)
  visibility     InviteVisibility @default(private)
  minLevel       Float?
  maxLevel       Float?
  radiusKm       Float?
  expiresAt      DateTime
  createdAt      DateTime         @default(now())

  inviter      User         @relation("InvitesSent", fields: [inviterUserId], references: [id])
  availability Availability @relation(fields: [availabilityId], references: [id])
  match        Match?

  matchType    MatchType    @default(competitive)

  @@index([inviterUserId])
  @@index([availabilityId])
  @@index([visibility, status])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@index([matchType])
}

enum InviteStatus {
  pending
  accepted
  cancelled
  expired
}

enum InviteVisibility {
  private
  community
}

////////////////////////////////////////////////////////////
// MATCH
////////////////////////////////////////////////////////////
/// Participants are stored in MatchParticipant. Teams (A/B) are assigned when result is loaded.
/// availability.userId = creator/owner of the slot.
///
model Match {
  id               String   @id @default(uuid())
  inviteId         String?  @unique
  availabilityId   String
  venueId          String?
  playerAId        String?
  playerBId        String?
  scheduledAt      DateTime
  createdAt        DateTime @default(now())

  /// WhatsApp group ID for scheduling matches (opened via chat.whatsapp.com)
  whatsappGroupId  String?

  /// Match type (competitive or practice)
  type             MatchType   @default(competitive)

  /// Match lifecycle status
  status           MatchStatus @default(scheduled)

  invite         Invite?        @relation(fields: [inviteId], references: [id])
  availability   Availability   @relation(fields: [availabilityId], references: [id])
  venue          Venue?         @relation(fields: [venueId], references: [id])
  playerA        Player?        @relation("PlayerA", fields: [playerAId], references: [id])
  playerB        Player?        @relation("PlayerB", fields: [playerBId], references: [id])
  result         Result?
  conversation   Conversation?
  participants   MatchParticipant[]
  reminders      Reminder[]

  schedulingRequest SchedulingRequest? @relation("SchedulingMatch")

  @@index([availabilityId])
  @@index([venueId])
  @@index([playerAId])
  @@index([playerBId])
  @@index([scheduledAt])
  @@index([createdAt])
  @@index([status])
  @@index([type])
}

////////////////////////////////////////////////////////////
// MATCH PARTICIPANT
////////////////////////////////////////////////////////////
/// Participant in a match. team is assigned when result is loaded (A vs B).
model MatchParticipant {
  id       String   @id @default(uuid())
  matchId  String
  userId   String
  team     String?  // 'A' | 'B' - null until result defines teams

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
}

enum MatchStatus {
  scheduled
  awaiting_confirmation
  completed
  cancelled
  disputed
}

enum MatchType {
  competitive
  practice
}

////////////////////////////////////////////////////////////
// RESULT
////////////////////////////////////////////////////////////

model Result {
  id             String   @id @default(uuid())
  matchId        String   @unique
  winnerUserId   String?
  createdAt      DateTime @default(now())
  submittedByUserId String?

  /// Result lifecycle status
  status         ResultStatus @default(draft)

  /// Confirmation/dispute tracking
  confirmedByHostAt     DateTime?
  confirmedByOpponentAt DateTime?
  disputedByHostAt      DateTime?
  disputedByOpponentAt  DateTime?

  match        Match       @relation(fields: [matchId], references: [id])
  winnerUser   User?       @relation("WinnerUser", fields: [winnerUserId], references: [id], onDelete: Restrict)
  sets         SetResult[]

  @@index([matchId])
  @@index([winnerUserId])
  @@index([createdAt])
  @@index([status])
}

enum ResultStatus {
  draft
  submitted
  confirmed
  disputed
}

////////////////////////////////////////////////////////////
// SET RESULT
////////////////////////////////////////////////////////////

model SetResult {
  id             String @id @default(uuid())
  resultId       String
  setNumber      Int
  playerAScore   Int
  playerBScore   Int
  tiebreakScoreA Int?
  tiebreakScoreB Int?

  result Result @relation(fields: [resultId], references: [id])

  @@unique([resultId, setNumber])
  @@index([resultId])
}

////////////////////////////////////////////////////////////
// VENUE
////////////////////////////////////////////////////////////

model Venue {
  id        String   @id @default(uuid())
  name      String
  city      String
  address   String?
  indoor    Boolean
  surface   String
  createdAt DateTime @default(now())

  matches Match[]

  @@index([city])
  @@index([surface])
  @@index([createdAt])
}

////////////////////////////////////////////////////////////
// REMINDER — scheduled WhatsApp reminders for matches
////////////////////////////////////////////////////////////

model Reminder {
  id          String   @id @default(uuid())
  userId      String
  matchId     String
  scheduledAt DateTime
  status      ReminderStatus @default(pending)
  sentAt      DateTime?
  error       String?
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([matchId])
  @@index([scheduledAt])
  @@index([status])
}

enum ReminderStatus {
  pending
  sent
  failed
}

////////////////////////////////////////////////////////////
// NOTIFICATION
////////////////////////////////////////////////////////////

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([readAt])
  @@index([createdAt])
}

////////////////////////////////////////////////////////////
// GROUPS
////////////////////////////////////////////////////////////

model Group {
  id          String   @id @default(uuid())
  name        String
  ownerUserId String
  createdAt   DateTime @default(now())

  owner   User          @relation("GroupsOwned", fields: [ownerUserId], references: [id])
  members GroupMember[]

  @@index([ownerUserId])
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

////////////////////////////////////////////////////////////
// CHAT
////////////////////////////////////////////////////////////

model Conversation {
  id        String           @id @default(uuid())
  type      ConversationType
  matchId   String?          @unique
  createdAt DateTime         @default(now())

  match    Match?    @relation(fields: [matchId], references: [id])
  messages Message[]

  @@index([type])
}

enum ConversationType {
  direct
  group
  match
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderUserId   String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation("SenderMessages", fields: [senderUserId], references: [id])

  @@index([conversationId])
  @@index([senderUserId])
}

////////////////////////////////////////////////////////////
// RATING HISTORY
////////////////////////////////////////////////////////////

model RatingHistory {
  id             String   @id @default(uuid())
  playerId       String
  matchId        String
  oldRating      Float
  newRating      Float
  delta          Float
  oldConfidence  Float
  newConfidence  Float
  createdAt      DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@index([playerId])
  @@index([matchId])
}

////////////////////////////////////////////////////////////
// SCHEDULING AUTOMATION
////////////////////////////////////////////////////////////

model SchedulingRequest {
  id                    String                @id @default(uuid())
  hostUserId            String
  hostPartnerUserId     String?
  sportType             SchedulingSportType
  format                SchedulingFormat      @default(singles)
  matchType             SchedulingMatchType   @default(competitive)
  date                  DateTime
  startTime             DateTime
  endTime               DateTime
  locationText          String
  radiusKm              Float?
  responseWindowMinutes Float                 @default(240)
  maxParallelCandidates Int                   @default(1)
  inviteToken           String                @unique
  status                SchedulingRequestStatus @default(active)
  currentCandidateIndex Int                   @default(0)
  matchId               String?               @unique
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  hostUser       User                 @relation("SchedulingHost", fields: [hostUserId], references: [id], onDelete: Restrict)
  hostPartner    User?                @relation("SchedulingHostPartner", fields: [hostPartnerUserId], references: [id], onDelete: SetNull)
  candidates     SchedulingCandidate[]
  match          Match?               @relation("SchedulingMatch", fields: [matchId], references: [id], onDelete: SetNull)

  @@index([hostUserId])
  @@index([status])
  @@index([inviteToken])
}

enum SchedulingRequestStatus {
  active
  completed
  expired
  cancelled
}

enum SchedulingFormat {
  singles
  doubles
}

enum SchedulingMatchType {
  competitive
  practice
}

enum SchedulingSportType {
  tennis
  padel
}

model SchedulingCandidate {
  id                    String                 @id @default(uuid())
  schedulingRequestId   String
  contactUserId         String
  priorityOrder         Int
  retryOrder            Int?
  status                SchedulingCandidateStatus @default(pending)
  contactedAt           DateTime?
  responseAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  schedulingRequest SchedulingRequest @relation(fields: [schedulingRequestId], references: [id], onDelete: Cascade)
  contactUser       User               @relation("SchedulingContact", fields: [contactUserId], references: [id], onDelete: Restrict)

  @@index([schedulingRequestId])
  @@index([contactUserId])
  @@index([priorityOrder])
  @@index([status])
}

enum SchedulingCandidateStatus {
  pending
  contacted
  waiting_reply
  accepted
  declined  // invitee said no (rejected)
  expired   // no response in time
  cancelled // host cancelled/skipped the candidate
}