# Frontend – Local development
# Copy to .env.local and adjust as needed

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000

# Fallback user ID when not logged in (dev only)
# Used when no auth token in localStorage. Run backend seed first.
VITE_CURRENT_USER_ID=023eddcc-c568-4091-8d7b-354a1744c7d4
